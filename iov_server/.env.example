# Required for generation.
OPENROUTER_API_KEY=sk-or-...
# Required unless DEBUG is set. Use a long random string; cli.py reads it too.
ADMIN_TOKEN=change-me
# Development only: with DEBUG=1 and no ADMIN_TOKEN, every request is admin.
# DEBUG=1
# Optional key for CIRCL's Vulnerability-Lookup (works without one).
# VULNERABILITY_LOOKUP_API_KEY=

# Model string as shown on openrouter.ai/models. It must support tool use and
# response_format, since generation pins the output to the IoV JSON schema.
LLM_MODEL=z-ai/glm-5.3-flash

# Research runs on OpenRouter's web search and web fetch server tools.
# Search engines: perplexity (default), native, exa, firecrawl, parallel.
# WEB_SEARCH_ENGINE=perplexity
# WEB_SEARCH_MAX_RESULTS=10
# WEB_FETCH_MAX_CONTENT_TOKENS=20000

# Which prompt drives generation. prompt6.txt is the current IoV format
# (format version 2: schema_version, references, arches/origin, typed CEL
# built-ins). Earlier prompts produce formats the agent evaluator no longer
# understands; it reports them as INCONCLUSIVE.
# PROMPT_PATH=/app/prompt/prompt6.txt

# Host port for docker-compose.
# IOV_SERVER_PORT=8000

# Server URL for cli.py.
# IOV_SERVER_URL=http://localhost:8000

# Generations running in parallel. They mostly wait on OpenRouter, so this can
# be well above the CPU count; mind OpenRouter's rate limits.
# CELERY_CONCURRENCY=8

# Reasoning effort per phase (GLM 5.3 Flash: low, high, max). OpenRouter maps
# other values, e.g. xhigh behaves like high. OPENROUTER_REASONING_EFFORT, if
# set, overrides all three.
# REASONING_EFFORT_RESEARCH=high
# REASONING_EFFORT_WRITE=high
# REASONING_EFFORT_CORRECTION=low
# OPENROUTER_REASONING_EFFORT=

# Provider routing: sort by "throughput", "price" or "latency" (empty for
# OpenRouter's default load balancing), and providers never to use (slugs,
# comma-separated).
# OPENROUTER_PROVIDER_SORT=throughput
# OPENROUTER_IGNORE_PROVIDERS=decart,wafer

# Research budget and wall-clock deadlines (seconds) per request.
# RESEARCH_MAX_SEARCHES=3
# RESEARCH_MAX_FETCHES=5
# RESEARCH_DEADLINE=600
# WRITE_DEADLINE=600
