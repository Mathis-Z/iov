# Copy to /etc/wazuh-evaluate-iov/daemon.env (mode 600).

# Base URL of the IoV server. Required.
IOV_SERVER_URL=http://iov-server.example:8000

# Where the mirrored IoV corpus lives. Evaluation always runs against this, so
# the host is still evaluated at boot when the server is unreachable.
#IOV_CACHE_DIR=/var/lib/wazuh-evaluate-iov

# How often to pull new IoVs, and how often to re-evaluate the host. Both are
# in seconds and are floored at 60. A pass also runs immediately on startup.
#IOV_SYNC_INTERVAL=3600
#IOV_EVAL_INTERVAL=86400

# The local Wazuh agent socket the verdicts are published through. The default
# is /var/ossec/queue/sockets/queue, falling back to the pre-4.x location.
#WAZUH_QUEUE_SOCKET=/var/ossec/queue/sockets/queue

# The event 'location' field. The manager's rules do not depend on it.
#IOV_EVENT_LOCATION=evaluate-iov

# DEBUG, INFO (default), WARNING, ERROR. Logs go to the journal.
#EVALUATE_IOV_LOG_LEVEL=INFO
