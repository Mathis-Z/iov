# Credentials below are the public wazuh-docker defaults; use your own.
# Wazuh API
WAZUH_API_HOST=localhost
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
# Indexer API (user/password match the dashboard ones)
WAZUH_INDEXER_HOST=localhost
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
# IoV server, as ETSO reaches it
IOV_SOURCE_URL=http://iov-server.example:8000
# Only for `cli.py queue-iovs`: the IoV server's admin token
ADMIN_TOKEN=
# Port ETSO listens on (the IoV server also defaults to 8000; change one if they share a host)
ETSO_PORT=8000
# IoV results (alerts index -> iov-results, with EPSS and CVSS)
WAZUH_ALERTS_INDEX=wazuh-alerts-*
POLL_INTERVAL=10
POLL_OVERLAP=300
SCORE_REFRESH_INTERVAL=300
IOV_PROJECTION_LOOKBACK=172800
# Optional: raises NVD's rate limit from 5 to 50 requests per 30 s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_MAX_LOOKUPS_PER_RUN=40
# Prioritisation dashboard, served at http://<etso>:${ETSO_PORT}/dashboard/
# "indexer" (live) or "demo" (bundled sample data, no Wazuh needed)
DASHBOARD_DATA_SOURCE=indexer
# Also rank CVEs Wazuh detected that have no IoV yet (true/false)
DASHBOARD_INCLUDE_DETECTIONS=true
# Age (s) at which the dashboard rebuilds its data in the background
DASHBOARD_CACHE_TTL=300
# IoV server URL as the user's browser reaches it (defaults to IOV_SOURCE_URL)
IOV_PUBLIC_URL=
